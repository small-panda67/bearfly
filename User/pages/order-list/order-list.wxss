/* pages/order-list/order-list.wxss */
.order-page { min-height: 100vh; background: #F5F6FA; }

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #4A90D9;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #4A90D9;
  border-radius: 2rpx;
}

.order-list { padding: 20rpx 24rpx; }
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.order-type { display: flex; align-items: center; }
.type-icon { font-size: 32rpx; margin-right: 12rpx; }
.type-name { font-size: 28rpx; font-weight: 600; color: #333; }
.order-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.order-status.pending { background: #FFF4E5; color: #E89B3C; }
.order-status.accepted { background: #E8F2FD; color: #4A90D9; }
.order-status.delivering { background: #F3E8FD; color: #8B5CF6; }
.order-status.completed { background: #E6F7EC; color: #2BA471; }
.order-status.cancelled { background: #F0F1F5; color: #999; }

.order-info {
  background: #F9FAFC;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.info-label {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.info-row:last-child .info-label { background: #2BA471; }
.info-text { font-size: 26rpx; color: #333; flex: 1; }
.info-line {
  width: 2rpx;
  height: 20rpx;
  background: #DDD;
  margin-left: 17rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-time { font-size: 22rpx; color: #999; }
.order-price { font-size: 32rpx; color: #E05252; font-weight: 700; }

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F5;
}
.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  border: 1rpx solid #DDD;
  color: #666;
}
.action-btn.primary {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}
.action-btn.danger {
  border-color: #E05252;
  color: #E05252;
}

.empty-btn {
  margin-top: 32rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
}
