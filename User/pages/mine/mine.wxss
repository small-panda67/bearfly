/* pages/mine/mine.wxss */
.mine-page { padding-bottom: 40rpx; }

/* 用户头部 */
.user-header {
  background: linear-gradient(180deg, #4A90D9 0%, #5BA0E8 100%);
  padding: 40rpx 24rpx 0;
}
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.user-detail { flex: 1; }
.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.verify-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.9);
}
.verify-tag.verified {
  background: #2BA471;
  color: #fff;
}
.user-campus { font-size: 24rpx; color: rgba(255,255,255,0.85); }

/* 钱包卡片 */
.wallet-card {
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}
.wallet-item {
  flex: 1;
  text-align: center;
}
.wallet-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}
.wallet-label { font-size: 22rpx; color: #999; }
.wallet-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEE;
}

/* 通用卡片 */
.section-card {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.section-more { font-size: 24rpx; color: #999; font-weight: normal; }

/* 订单快捷 */
.order-shortcuts {
  display: flex;
  padding: 16rpx 0 24rpx;
}
.shortcut-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.shortcut-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.shortcut-name { font-size: 24rpx; color: #666; }

/* 菜单 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F6FA;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}
.menu-name { flex: 1; font-size: 28rpx; color: #333; }
.menu-tag {
  background: #FFF4E5;
  color: #E89B3C;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.menu-arrow { color: #CCC; font-size: 32rpx; }

/* 退出 */
.logout-btn {
  margin: 40rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #E05252;
}
