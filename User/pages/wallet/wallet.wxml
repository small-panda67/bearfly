<!--pages/wallet/wallet.wxml-->
<view class="wallet-page">
  <view class="wallet-header">
    <view class="balance-label">账户余额（元）</view>
    <view class="balance-value">{{balance}}</view>
    <view class="wallet-actions">
      <view class="wallet-btn" bindtap="recharge">充值</view>
      <view class="wallet-btn outline" bindtap="withdraw">提现</view>
    </view>
  </view>
  <view class="section-card">
    <view class="card-title">交易记录</view>
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-icon">{{item.icon}}</view>
      <view class="record-info">
        <view class="record-name">{{item.name}}</view>
        <view class="record-time">{{item.time}}</view>
      </view>
      <view class="record-amount {{item.type}}">{{item.amount}}</view>
    </view>
  </view>
</view>
