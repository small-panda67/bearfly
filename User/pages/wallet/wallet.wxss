/* pages/wallet/wallet.wxss */
.wallet-page { min-height: 100vh; background: #F5F6FA; }
.wallet-header {
  background: linear-gradient(135deg, #4A90D9, #6BB1F0);
  padding: 60rpx 24rpx 40rpx;
  color: #fff;
}
.balance-label { font-size: 26rpx; opacity: 0.9; margin-bottom: 12rpx; }
.balance-value { font-size: 64rpx; font-weight: 700; margin-bottom: 32rpx; }
.wallet-actions { display: flex; gap: 24rpx; }
.wallet-btn {
  flex: 1; background: rgba(255,255,255,0.25); text-align: center;
  padding: 20rpx; border-radius: 40rpx; font-size: 28rpx;
}
.wallet-btn.outline { background: transparent; border: 1rpx solid rgba(255,255,255,0.5); }
.section-card { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.record-item {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F6FA;
}
.record-item:last-child { border-bottom: none; }
.record-icon { font-size: 36rpx; margin-right: 16rpx; }
.record-info { flex: 1; }
.record-name { font-size: 28rpx; color: #333; margin-bottom: 4rpx; }
.record-time { font-size: 22rpx; color: #999; }
.record-amount { font-size: 30rpx; font-weight: 600; }
.record-amount.income { color: #2BA471; }
.record-amount.expense { color: #E05252; }
