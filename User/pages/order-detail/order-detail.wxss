/* pages/order-detail/order-detail.wxss */
.detail-page { padding: 20rpx 24rpx 160rpx; }

/* 状态头部 */
.status-header {
  background: linear-gradient(135deg, #4A90D9, #6BB1F0);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  color: #fff;
}
.status-title { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.status-desc { font-size: 24rpx; opacity: 0.9; margin-bottom: 32rpx; }

.progress-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
}
.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.progress-step.done .step-dot {
  background: #fff;
  color: #4A90D9;
  font-weight: 700;
}
.step-text { font-size: 20rpx; opacity: 0.8; text-align: center; }
.progress-line {
  flex: 1;
  height: 4rpx;
  background: rgba(255,255,255,0.3);
  margin-top: 20rpx;
  margin-left: -10rpx;
  margin-right: -10rpx;
}
.progress-line.done { background: #fff; }

/* 跑腿员卡片 */
.rider-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.rider-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8F2FD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.rider-info { flex: 1; }
.rider-name { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.rider-meta { font-size: 22rpx; color: #999; }
.rider-actions { display: flex; gap: 16rpx; }
.rider-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F7FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

/* 轨迹 */
.track-map {
  height: 240rpx;
  background: #F5F6FA;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.map-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #BBB;
  font-size: 24rpx;
}
.map-icon { font-size: 48rpx; margin-bottom: 12rpx; }

.track-timeline { padding-left: 8rpx; }
.track-item {
  display: flex;
  padding-bottom: 24rpx;
  position: relative;
}
.track-item:last-child { padding-bottom: 0; }
.track-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #DDD;
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.track-dot.active { background: #4A90D9; }
.track-content { flex: 1; }
.track-text { font-size: 26rpx; color: #333; margin-bottom: 4rpx; }
.track-time { font-size: 22rpx; color: #999; }

/* 信息 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F6FA;
}
.info-row:last-child { border-bottom: none; }
.info-label { width: 160rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: #333; text-align: right; }

/* 费用 */
.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.fee-name { font-size: 26rpx; color: #666; }
.fee-value { font-size: 26rpx; color: #333; }
.fee-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 1rpx dashed #E0E0E0;
}
.total-label { font-size: 28rpx; font-weight: 500; }
.total-value { font-size: 36rpx; color: #E05252; font-weight: 700; }

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.bottom-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: 1rpx solid #DDD;
  color: #666;
}
.bottom-btn.primary {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}
.bottom-btn.danger {
  border-color: #E05252;
  color: #E05252;
}
