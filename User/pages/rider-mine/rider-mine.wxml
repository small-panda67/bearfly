<!--pages/rider-mine/rider-mine.wxml 跑腿员个人中心-->
<view class="rider-mine-page">
  <!-- 头部信息 -->
  <view class="rider-header">
    <view class="rider-info">
      <view class="rider-avatar">{{rider.avatar}}</view>
      <view class="rider-detail">
        <view class="rider-name">
          {{rider.name}}
          <text class="level-tag">Lv.{{rider.level}}</text>
        </view>
        <view class="rider-meta">⭐ {{rider.rating}} · 完成{{rider.totalOrders}}单</view>
        <view class="rider-status {{rider.verified ? 'verified' : ''}}">
          {{rider.verified ? '✓ 已认证' : '未认证'}}
        </view>
      </view>
    </view>
    <!-- 收入卡片 -->
    <view class="income-card">
      <view class="income-item">
        <view class="income-value">¥{{rider.todayIncome}}</view>
        <view class="income-label">今日收入</view>
      </view>
      <view class="income-divider"></view>
      <view class="income-item">
        <view class="income-value">¥{{rider.balance}}</view>
        <view class="income-label">可提现</view>
      </view>
      <view class="income-divider"></view>
      <view class="income-item">
        <view class="income-value">{{rider.monthOrders}}</view>
        <view class="income-label">本月单量</view>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card card">
    <view class="card-title">配送数据</view>
    <view class="stats-grid">
      <view class="stat-box">
        <view class="stat-num">{{rider.completionRate}}%</view>
        <view class="stat-name">完成率</view>
      </view>
      <view class="stat-box">
        <view class="stat-num">{{rider.avgTime}}min</view>
        <view class="stat-name">平均配送</view>
      </view>
      <view class="stat-box">
        <view class="stat-num">{{rider.goodRate}}%</view>
        <view class="stat-name">好评率</view>
      </view>
      <view class="stat-box">
        <view class="stat-num">{{rider.onTimeRate}}%</view>
        <view class="stat-name">准时率</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section-card">
    <view class="menu-item" bindtap="goWallet">
      <view class="menu-icon">💰</view>
      <view class="menu-name">我的钱包</view>
      <view class="menu-extra">¥{{rider.balance}}</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goWithdraw">
      <view class="menu-icon">🏦</view>
      <view class="menu-name">提现</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goDeposit">
      <view class="menu-icon">🔒</view>
      <view class="menu-name">保证金管理</view>
      <view class="menu-extra">¥{{rider.deposit}}</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goIncome">
      <view class="menu-icon">📊</view>
      <view class="menu-name">收入明细</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section-card">
    <view class="menu-item" bindtap="goSettings">
      <view class="menu-icon">⚙️</view>
      <view class="menu-name">接单设置</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goLevel">
      <view class="menu-icon">🏆</view>
      <view class="menu-name">等级与权益</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goHelp">
      <view class="menu-icon">❓</view>
      <view class="menu-name">帮助中心</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goService">
      <view class="menu-icon">🎧</view>
      <view class="menu-name">联系客服</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 切换回用户模式 -->
  <view class="switch-user" bindtap="switchToUser">切换回用户模式</view>
</view>
