/* pages/rider-mine/rider-mine.wxss */
.rider-mine-page { padding-bottom: 40rpx; }

.rider-header {
  background: linear-gradient(180deg, #2BA471 0%, #3DBB85 100%);
  padding: 40rpx 24rpx 0;
}
.rider-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.rider-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}
.rider-detail { flex: 1; }
.rider-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.level-tag {
  background: #FFD700;
  color: #8B6914;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  font-weight: 600;
}
.rider-meta { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-bottom: 8rpx; }
.rider-status {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.9);
}
.rider-status.verified { background: rgba(255,255,255,0.9); color: #2BA471; }

.income-card {
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}
.income-item { flex: 1; text-align: center; }
.income-value { font-size: 36rpx; font-weight: 700; color: #2BA471; margin-bottom: 6rpx; }
.income-label { font-size: 22rpx; color: #999; }
.income-divider { width: 1rpx; height: 60rpx; background: #EEE; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx 0;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-box {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}
.stat-num { font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 6rpx; }
.stat-name { font-size: 22rpx; color: #999; }

.section-card {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F6FA;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; margin-right: 20rpx; width: 40rpx; text-align: center; }
.menu-name { flex: 1; font-size: 28rpx; color: #333; }
.menu-extra { font-size: 26rpx; color: #2BA471; margin-right: 12rpx; }
.menu-arrow { color: #CCC; font-size: 32rpx; }

.switch-user {
  margin: 40rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A90D9;
}
