/* pages/admin-mobile/admin-mobile.wxss */
.admin-page { min-height: 100vh; background: #F5F6FA; }

/* 登录 */
.login-section { padding: 0 40rpx; }
.login-header {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.admin-logo {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  border-radius: 36rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.admin-title { font-size: 40rpx; font-weight: 700; color: #333; margin-bottom: 8rpx; }
.admin-desc { font-size: 26rpx; color: #999; }

.login-form { padding: 40rpx 32rpx; }
.form-group {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}
.form-label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.form-input { font-size: 30rpx; color: #333; }
.login-btn { margin-top: 40rpx; width: 100%; }
.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 24rpx;
}

/* 管理后台主体 */
.admin-header {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.admin-info { display: flex; align-items: center; }
.admin-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.admin-detail { }
.admin-name { font-size: 32rpx; font-weight: 600; color: #fff; margin-bottom: 4rpx; }
.admin-role { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.logout-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

/* 数据概览 */
.overview-card {
  background: #fff;
  margin: -20rpx 24rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.overview-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; color: #333; }
.overview-grid { display: flex; flex-wrap: wrap; }
.overview-item {
  width: 25%;
  text-align: center;
  padding: 12rpx 0;
}
.overview-value { font-size: 32rpx; font-weight: 700; color: #6C5CE7; margin-bottom: 4rpx; }
.overview-label { font-size: 20rpx; color: #999; }

/* 待办 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
}
.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F6FA;
}
.todo-item:last-child { border-bottom: none; }
.todo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.todo-icon.verify { background: #FFF4E5; }
.todo-icon.complaint { background: #FDECEC; }
.todo-icon.withdraw { background: #E6F7EC; }
.todo-content { flex: 1; }
.todo-name { font-size: 28rpx; color: #333; margin-bottom: 4rpx; }
.todo-desc { font-size: 22rpx; color: #999; }
.todo-count {
  background: #E05252;
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  text-align: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
}
.todo-arrow { color: #CCC; font-size: 28rpx; }

/* 菜单 */
.menu-section {
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.menu-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; color: #333; }
.menu-grid {
  display: flex;
  flex-wrap: wrap;
}
.menu-grid .menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.menu-grid .menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F5F6FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}
.menu-grid .menu-name { font-size: 24rpx; color: #333; }
